    $ringsFilter: PoeRingsFilter
    $shieldsFilter: PoeShieldsFilter
    $weaponsFilter: PoeWeaponsFilter
    $gemsFilter: PoeGemsFilter
    $graftsFilter: PoeGraftsFilter
    $masteryEffectsFilter: PoeMasteryEffectsFilter
  ) {
    game: poe {
      staticData {
        groups {
          amulets(filter: $amuletsFilter) {
            data {
              ...PoeStaticDataAmuletsFragment
            }
          }
          armours(filter: $armoursFilter) {
            data {
              ...PoeStaticDataArmoursFragment
            }
          }
          belts(filter: $beltsFilter) {
            data {
              ...PoeStaticDataBeltsFragment
            }
          }
          flasks(filter: $flasksFilter) {
            data {
              ...PoeStaticDataFlasksFragment
            }
          }
          quivers(filter: $quiversFilter) {
            data {
              ...PoeStaticDataQuiversFragment
            }
          }
          rings(filter: $ringsFilter) {
            data {
              ...PoeStaticDataRingsFragment
            }
          }
          shields(filter: $shieldsFilter) {
            data {
              ...PoeStaticDataShieldsFragment
            }
          }
          weapons(filter: $weaponsFilter) {
            data {
              ...PoeStaticDataWeaponsFragment
            }
          }
          gems(filter: $gemsFilter) {
            data {
              ...PoeStaticDataGemsFragment
            }
          }
          characters(filter: $charactersFilter) {
            data {
              ...PoeStaticDataCharactersFragment
            }
          }
          passiveSkillsNodes(filter: $passiveSkillNodesFilter) {
            data {
              ...PoeStaticDataPassiveSkillNodesFragment
            }
          }
          passiveSkills(filter: $passiveSkillsFilter) {
            data {
              ...PoeStaticDataPassiveSkillsFragment
            }
          }
          passiveSkillsGraph(filter: $passiveSkillsGraphFilter) {
            data {
              ...PoeStaticDataPassiveSkillsGraphFragment
            }
          }
          passiveSkillTreeRestrictions {
            data {
              slug
              limit
            }
          }
          jewelRadii {
            data {
              ...PoeStaticDataJewelRadiiFragment
            }
          }
          jewels(filter: $jewelsFilter) {
            data {
              ...PoeStaticDataJewelsFragment
            }
          }
          ascendancies(filter: $ascendanciesFilter) {
            data {
              ...PoeStaticDataAscendancyFragment
            }
          }
          alternateAscendancies(filter: $alternateAscendanciesFilter) {
            data {
              ...PoeStaticDataAlternateAscendancyFragment
            }
          }
          masteryEffects(filter: $masteryEffectsFilter) {
            data {
              ...PoeStaticDataMasteryEffectsFragment
            }
          }
          grafts(filter: $graftsFilter) {
            data {
              ...PoeStaticDataGraftsFragment
            }
          }
        }
        meta: metadata {
          version: dataVersion
        }
      }
    }
  }

